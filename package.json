{
  "name": "@lepropst/xchacha20-poly1305",
  "version": "1.0.0",
  "description": "XChacha20 Poly 1305 authenticated encryption with additional data library including a password-based key derivation function.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "xchacha20",
    "poly1305",
    "aead",
    "encryption",
    "cryptography"
  ],
  "author": "Elias Rangel",
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.10.1",
    "@types/web": "^0.0.294",
    "@vitest/coverage-v8": "^4.0.12",
    "husky": "^9.1.7",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.12"
  }
}
